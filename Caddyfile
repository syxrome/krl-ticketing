# Caddyfile — KRL Fare Simulator Static SPA Hosting

# Development / Local
localhost {
    root * /path/to/krl/dist
    file_server

    # SPA fallback: semua path dikembalikan ke index.html
    try_files {path} /index.html

    # CORS header jika dibutuhkan
    header Access-Control-Allow-Origin "*"
}

# Production (ganti dengan domain Anda)
